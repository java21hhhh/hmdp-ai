# =============================================================================
#  .env 模板 —— 把它复制成 .env，再把值填成真的
# =============================================================================
#
#     cp .env.example .env
#     vi .env
#
#  ★ 为什么密钥写在这个文件里，而不是写进 docker-compose.yml？
#
#    docker-compose.yml 是【要提交到 Git 的】—— 它是部署说明书，
#    别人 clone 下来照着跑就该能起来。密钥一旦写进去就跟着上 GitHub 了。
#
#    所以分工是：
#       docker-compose.yml  → 只写"从环境变量取"，写 ${XXX}
#       .env                → 只在你服务器上存在，装真值
#       .env.example        → 提交到 Git，只有占位符，告诉别人要填哪些
#
#  ★ .env 已经在 .gitignore 里了（我确认过），git add . 也带不走它。
#    但别因为这样就放松 —— 重点是【永远不要】把真 key 粘进 compose 或 yml。
#
#  ★ 密码只用【字母 + 数字】。
#    带 $ 或 " 的密码在 compose 的变量替换里会被吃掉或截断，
#    然后你会看到 "Access denied" 却怎么查都对不上，白丢半小时。
# =============================================================================

# ---- MySQL root 密码（自己编一个）------------------------------------------
# 只在这个 Docker 内网里用得到。生成一串随机的就行，不用记。
# 例：openssl rand -hex 16
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_pw

# ---- DeepSeek 的 API key ----------------------------------------------------
# 和你本地「启动.bat」里 set 的那个是同一个，直接抄过来（别新建）。
# 形如 sk- 开头的一长串。这个是真的能花钱的，别外传。
DEEPSEEK_API_KEY=sk-CHANGE_ME

# ---- 这个服务自己的访问钥匙 ------------------------------------------------
# 每个请求都要在头里带 X-Api-Key，对不上就是 401。
# ⚠️ 这一项【不能留空】—— 空着 compose 直接拒绝启动（故意的，
#    宁可起不来，也不要一个"以为有保护、其实裸奔"的服务）。
#
# 另编一串，跟上面两个都不一样。例：openssl rand -hex 24
HMDP_AI_API_KEY=CHANGE_ME_long_random_string

# ---- 端口 ------------------------------------------------------------------
# 公网访问 hmdp-ai 用的端口。被占用就改这里，改完 docker compose up -d 即可。
PUBLIC_PORT=8082

# Zipkin 界面的端口。注意它只绑在 127.0.0.1，公网直接访问不到，
# 要先开 SSH 隧道（命令见 README 第 7 步）。
ZIPKIN_PORT=9411

# ---- 内存档位（★ 买完机器，第一件事就是核对这一段）-------------------------
#
# 什么都不填 = 按【2核4G】配（用 docker-compose.yml 里的默认值）。
#
# ★ 如果你买的是【2核2G】：把下面 4 行的 # 去掉（4 个都要），
#   再把下面 COMPOSE_PROFILES 那一行改成空的（COMPOSE_PROFILES=）。
#
#   MEM_HMDP_AI=512m
#   MEM_HMDP=384m
#   MEM_MYSQL=384m
#   MEM_REDIS=96m
#
# 忘了改会怎样：**不会报错**。容器被内核悄悄杀掉（exit code 137），
# 你只会看到"服务莫名其妙重启了"，然后开始怀疑人生。
# 原理见 docker-compose.yml 开头那段"内存上限"注释。

# ---- 要不要启动 Zipkin（链路追踪）-------------------------------------------
# 填 trace = 启动；留空（COMPOSE_PROFILES=）= 不启动。
#
#   2核4G → 可以填 trace，用 SSH 隧道看链路界面（README 第 7 步）
#   2核2G → 【留空】。zipkin 自己就要约 350M，带上就贴近 OOM。
#
# 关掉它不影响简历：链路截图你本地已经拿到了。
COMPOSE_PROFILES=trace
